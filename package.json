{
  "name": "curvesmith",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "Professional vector design in your browser.",
  "license": "MIT",
  "scripts": {
    "dev": "vite --port 5186 --strictPort",
    "build": "tsc -b && vite build",
    "preview": "vite preview --port 5186 --strictPort",
    "typecheck": "tsc -b",
    "lint": "eslint .",
    "format": "prettier --write .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "fonts:update": "node scripts/update-google-fonts.mjs",
    "screenshot": "node scripts/screenshot.mjs"
  },
  "dependencies": {
    "@pdf-lib/fontkit": "^1.1.1",
    "@radix-ui/react-context-menu": "^2.4.1",
    "@radix-ui/react-dialog": "^1.3.1",
    "@radix-ui/react-dropdown-menu": "^2.2.1",
    "@radix-ui/react-popover": "^1.3.1",
    "@radix-ui/react-select": "^2.4.1",
    "@radix-ui/react-tooltip": "^1.4.1",
    "cmdk": "^1.1.1",
    "fflate": "^0.8.3",
    "immer": "^11.1.21",
    "onnxruntime-web": "1.30.0",
    "opentype.js": "^2.0.0",
    "pathkit-wasm": "^1.0.0",
    "pdf-lib": "^1.17.1",
    "pdfjs-dist": "^6.4.299",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "sonner": "^2.0.8",
    "wawoff2": "^2.0.1",
    "zustand": "^5.0.15"
